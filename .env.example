# Copy this file to .env.local and replace placeholders locally.
# Never commit .env.local or real credentials.

# Required: MongoDB connection string. DevFlow currently uses the "devflow" database.
MONGODB_URI=mongodb://127.0.0.1:27017/devflow

# Required: Auth.js and feed-cursor HMAC secret. Generate locally with: openssl rand -base64 32
AUTH_SECRET=

# Auth.js trusted origin. Use the same public HTTPS origin as the deployed app.
AUTH_URL=http://localhost:3000

# Public canonical origin used by metadata, Open Graph, robots, and sitemap.
# Set the deployed HTTPS origin in production; this value is not a secret.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: enable GitHub OAuth login.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Optional: enable Google OAuth login.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional: AI provider settings. Keep API keys server-only.
AI_API_KEY=
# Temporary compatibility key for older local setups; prefer AI_API_KEY.
MINIMAX_API_KEY=
# MINIMAX_BASE_URL=
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-v4-flash
# Set true only when the configured provider accepts OpenAI JSON Schema output.
# AI_SUPPORTS_STRUCTURED_OUTPUTS=false
# AI_RATE_LIMIT_PER_HOUR=10
# AI_RATE_LIMIT_PER_DAY=30
# Optional global override. Defaults: question analysis 2200, answer helper 1800.
# AI_MAX_OUTPUT_TOKENS=2200
# AI_REQUEST_TIMEOUT_MS=30000

# Optional: job-search provider key. Keep this server-only.
RAPID_API_KEY=
# DEFAULT_JOB_LOCATION=China

# Optional: trace, debug, info, warn, error, or fatal.
LOG_LEVEL=info

# Optional: privacy-bounded observability. Both switches are opt-in.
# The NEXT_PUBLIC flag is embedded into the browser bundle at build time and is
# not a secret. The server flag is evaluated at runtime.
# OBSERVABILITY_ENABLED=false
# NEXT_PUBLIC_OBSERVABILITY_ENABLED=false
# Sample 0% to 100% of page loads for Web Vitals. Client/server errors are not sampled.
# NEXT_PUBLIC_WEB_VITALS_SAMPLE_RATE=0.1
# Optional server-to-server HTTPS collector. Without it, events still use structured logs.
# OBSERVABILITY_ENDPOINT=
# Optional bearer token sent only by the server. Never use a NEXT_PUBLIC_ prefix.
# OBSERVABILITY_TOKEN=

# Local seed only: choose your own strong password for demo@devflow.local.
# The seed command refuses to run with NODE_ENV=production.
DEMO_USER_PASSWORD=
