# Copy this file to .env.local and replace placeholders locally.
# Never commit .env.local or real credentials.

# Required: MongoDB connection string. DevFlow currently uses the "devflow" database.
MONGODB_URI=mongodb://127.0.0.1:27017/devflow

# Required: Auth.js signing secret. Generate locally with: openssl rand -base64 32
AUTH_SECRET=

# Optional: enable GitHub OAuth login.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Optional: enable Google OAuth login.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional: AI provider settings. Keep API keys server-only.
AI_API_KEY=
# Temporary compatibility key for older local setups; prefer AI_API_KEY.
MINIMAX_API_KEY=
# MINIMAX_BASE_URL=
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-v4-flash
# Set true only when the configured provider accepts OpenAI JSON Schema output.
# AI_SUPPORTS_STRUCTURED_OUTPUTS=false
# AI_RATE_LIMIT_PER_HOUR=10
# AI_RATE_LIMIT_PER_DAY=30
# AI_MAX_OUTPUT_TOKENS=1800
# AI_REQUEST_TIMEOUT_MS=30000

# Optional: job-search provider key. Keep this server-only.
RAPID_API_KEY=
# DEFAULT_JOB_LOCATION=China

# Optional: trace, debug, info, warn, error, or fatal.
LOG_LEVEL=info

# Local seed only: choose your own strong password for demo@devflow.local.
# The seed command refuses to run with NODE_ENV=production.
DEMO_USER_PASSWORD=
